{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/tauri-v2-json-schemas/main/tauri.conf.json",
  "productName": "AI Record Label",
  "version": "0.1.0",
  "identifier": "com.airecordlabel.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Record Label",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
