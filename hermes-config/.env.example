# =============================================================================
# AI Record Label — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before running.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Routing (OpenRouter)
# -----------------------------------------------------------------------------
# OpenRouter API key — routes to Claude Opus (A&R, Creative Director) and
# Claude Sonnet (Manager) depending on agent profile config.
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Audio & Artwork Analysis (Gemini 2.5 Pro)
# -----------------------------------------------------------------------------
# Google AI / Gemini API key — used directly (not through OpenRouter) for
# multimodal audio analysis and Gemini Vision artwork review.
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Also accepted as GOOGLE_API_KEY (either works):
# GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# SMS Messaging (Twilio)
# -----------------------------------------------------------------------------
# Twilio credentials — single phone number shared by all agents.
# Get yours at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Artist's phone number for receiving agent messages
ARTIST_PHONE_NUMBER=+1XXXXXXXXXX

# -----------------------------------------------------------------------------
# Bandcamp Agent
# -----------------------------------------------------------------------------
# API token for authenticating requests to the Bandcamp FastAPI sidecar.
# Can be any secure random string — must match between Hermes and the agent.
BACKEND_API_TOKEN=

# Bandcamp artist page URL (e.g., https://yourname.bandcamp.com)
BCA_ARTIST_URL=

# -----------------------------------------------------------------------------
# Backblaze B2 Vault (S3-compatible)
# -----------------------------------------------------------------------------
# Write key — used by sync_to_cloud.sh to upload new files to the vault
B2_WRITE_KEY_ID=
B2_WRITE_APPLICATION_KEY=
# Read key — used by agents to list/read vault contents
B2_READ_KEY_ID=
B2_READ_APPLICATION_KEY=
# Bucket name and S3 endpoint (format: https://s3.<region>.backblazeb2.com)
B2_BUCKET_NAME=ai-record-label-vault
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Path to the SQLite database file (inside container: /data/hermes.db)
# For local development, use a relative or absolute path on the host.
DB_PATH=/data/hermes.db

# -----------------------------------------------------------------------------
# File Watcher
# -----------------------------------------------------------------------------
# Absolute path to the DAW export / bounce folder that the file watcher monitors.
# New audio files dropped here trigger the A&R review pipeline.
WATCH_FOLDER=/path/to/your/daw/exports

# -----------------------------------------------------------------------------
# Hermes Runtime (optional overrides)
# -----------------------------------------------------------------------------
# HERMES_LOG_LEVEL=info
# HERMES_PORT=3000
