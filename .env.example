# =============================================================================
# AI Record Label — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before running launch.sh.
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Routing (OpenRouter)
# -----------------------------------------------------------------------------
# Routes to Claude Opus 4.6 (A&R, Creative Director) and
# Claude Sonnet 4.6 (Manager, Bandcamp, Intake) per agent config.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Audio & Artwork Analysis (Gemini 2.5 Pro)
# -----------------------------------------------------------------------------
# Used directly (not through OpenRouter) for multimodal audio analysis
# and Gemini Vision artwork review.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Also accepted as GOOGLE_API_KEY (either name works):
# GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# SMS Messaging (Twilio)
# -----------------------------------------------------------------------------
# Single phone number shared by all agents.
# Get yours at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Artist's personal cell — receives all agent SMS messages
ARTIST_PHONE_NUMBER=+1XXXXXXXXXX

# -----------------------------------------------------------------------------
# Backblaze B2 Vault (S3-compatible, permanent audio archive)
# -----------------------------------------------------------------------------
# Write key — used by sync_to_cloud.sh to upload new files
B2_WRITE_KEY_ID=
B2_WRITE_APPLICATION_KEY=
# Read key — used by agents to list/read vault contents
B2_READ_KEY_ID=
B2_READ_APPLICATION_KEY=
# Your B2 bucket name and regional S3 endpoint
B2_BUCKET_NAME=ai-record-label-vault
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# -----------------------------------------------------------------------------
# HTTP API Authentication
# -----------------------------------------------------------------------------
# Bearer token that protects all API endpoints.
# On Mac: auto-generated on first run, saved to $DATA_DIR/api_token.txt.
# On Render: set this explicitly so you always know the token without
#            digging through deployment logs. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_TOKEN=

# -----------------------------------------------------------------------------
# Bandcamp Agent
# -----------------------------------------------------------------------------
# Your Bandcamp artist page (e.g., https://yourname.bandcamp.com)
BCA_ARTIST_URL=

# -----------------------------------------------------------------------------
# File Watcher
# -----------------------------------------------------------------------------
# Absolute path to your DAW export/bounce folder.
# Files dropped here trigger the full A&R → release pipeline.
# On Mac with Google Drive: ~/Library/CloudStorage/GoogleDrive-.../My Drive/AI Record Label/inbox
WATCH_FOLDER=/path/to/your/daw/exports

# -----------------------------------------------------------------------------
# Data Directory (optional — overrides platform default)
# -----------------------------------------------------------------------------
# Default: ~/Library/Application Support/ai-record-label (Mac)
#          %APPDATA%\ai-record-label (Windows)
#          ~/.local/share/ai-record-label (Linux)
# AI_RECORD_LABEL_DATA=/custom/path

# -----------------------------------------------------------------------------
# Hermes Runtime (optional)
# -----------------------------------------------------------------------------
# HERMES_LOG_LEVEL=info
# HERMES_PORT=3000
# HERMES_BIN=/path/to/hermes

# -----------------------------------------------------------------------------
# Google Calendar Sync (optional — session intelligence feature)
# -----------------------------------------------------------------------------
# Calendar ID to sync Ableton sessions to (default: "primary")
# HERMES_CALENDAR_ID=primary
# CREDENTIALS_PATH=/path/to/google-oauth-credentials.json
